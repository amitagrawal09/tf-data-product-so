// =====================================================================================
// Sales Order data product – Azure reference architecture (Tier 2: Azure Integration
// Services + Container Apps; data hub: ADLS Gen2 / Event Hubs for Azure Databricks).
// Resource-group scoped. deploy.sh creates the resource group and drives this template.
// =====================================================================================
targetScope = 'resourceGroup'

@description('Short name prefix (lowercase letters/digits, 2-8 chars)')
@minLength(2)
@maxLength(8)
param prefix string = 'tfso'

@description('Azure region')
param location string = resourceGroup().location

@allowed([ 'dev', 'test', 'prod' ])
param environment string = 'dev'

@description('Container image repository name inside ACR')
param containerImageRepo string = 'tfso-sales-order'

@description('Image tag built by deploy.sh (az acr build). Ignored when usePlaceholderImage = true.')
param imageTag string = 'latest'

@description('First deployment only: run a public placeholder image until the real image is in ACR')
param usePlaceholderImage bool = false

@description('PostgreSQL Flexible Server administrator login')
param postgresAdminLogin string = 'tfsoadmin'

@secure()
@description('PostgreSQL administrator password (generated by deploy.sh and kept in .deploy/<env>.env)')
param postgresAdminPassword string

@secure()
@description('Backend API key injected by APIM and accepted by the services (x-api-key)')
param apiKey string

@description('APIM publisher e-mail')
param apimPublisherEmail string

@allowed([ 'Consumption', 'Developer', 'Basic', 'Standard', 'Premium', 'BasicV2', 'StandardV2' ])
param apimSku string = 'Developer'

@description('Dynamics 365 F&O environment URL. Empty = System API runs the D365 simulator.')
param d365Url string = ''
param d365TenantId string = ''
param d365ClientId string = ''
@secure()
param d365ClientSecret string = ''
param d365Company string = 'usmf'

@description('Our X12 interchange sender id for outbound 997/855/856/810')
param isaSenderId string = 'TAYLORFARMS'

@description('Expose the System API (simulator, master data) via APIM; automatically off in prod')
param exposeSystemApi bool = environment != 'prod'

var stem = '${prefix}-${environment}'
var suffix = take(uniqueString(resourceGroup().id, prefix, environment), 6)
var compact = toLower(replace('${prefix}${environment}${suffix}', '-', ''))
var tags = {
  'data-product': 'sales-order'
  environment: environment
  'managed-by': 'bicep'
  workload: 'order-status-api'
}

module monitoring 'modules/monitoring.bicep' = {
  name: 'monitoring'
  params: {
    location: location
    stem: stem
    tags: tags
    retentionInDays: environment == 'prod' ? 90 : 30
  }
}

module identity 'modules/identity.bicep' = {
  name: 'identity'
  params: { location: location, stem: stem, tags: tags }
}

module acr 'modules/acr.bicep' = {
  name: 'acr'
  params: {
    location: location
    name: take('acr${compact}', 50)
    tags: tags
    sku: environment == 'prod' ? 'Standard' : 'Basic'
  }
}

module serviceBus 'modules/servicebus.bicep' = {
  name: 'servicebus'
  params: {
    location: location
    name: 'sb-${stem}-${suffix}'
    tags: tags
    sku: environment == 'prod' ? 'Premium' : 'Standard'
  }
}

module eventHubs 'modules/eventhubs.bicep' = {
  name: 'eventhubs'
  params: {
    location: location
    name: 'evh-${stem}-${suffix}'
    tags: tags
  }
}

module storage 'modules/storage.bicep' = {
  name: 'storage'
  params: {
    location: location
    lakeName: take('stlake${compact}', 24)
    webName: take('stweb${compact}', 24)
    tags: tags
    skuName: environment == 'prod' ? 'Standard_ZRS' : 'Standard_LRS'
  }
}

module postgres 'modules/postgres.bicep' = {
  name: 'postgres'
  params: {
    location: location
    name: 'psql-${stem}-${suffix}'
    tags: tags
    administratorLogin: postgresAdminLogin
    administratorLoginPassword: postgresAdminPassword
    environment: environment
  }
}

module docIntel 'modules/docintel.bicep' = {
  name: 'docintel'
  params: {
    location: location
    name: 'di-${stem}-${suffix}'
    tags: tags
  }
}

var pgHost = '${postgres.outputs.name}.postgres.database.azure.com'
var dbUrlBase = 'postgresql+psycopg://${postgresAdminLogin}:${uriComponent(postgresAdminPassword)}@${pgHost}:5432'

module keyVault 'modules/keyvault.bicep' = {
  name: 'keyvault'
  params: {
    location: location
    name: take('kv-${prefix}-${environment}-${suffix}', 24)
    tags: tags
    postgresAdminPassword: postgresAdminPassword
    apiKey: apiKey
    d365ClientSecret: d365ClientSecret
    processDbUrl: '${dbUrlBase}/tfso_process?sslmode=require'
    systemDbUrl: '${dbUrlBase}/tfso_system?sslmode=require'
    appInsightsConnectionString: monitoring.outputs.appInsightsConnectionString
    enablePurgeProtection: environment == 'prod'
  }
}

module roles 'modules/roles.bicep' = {
  name: 'roles'
  params: {
    principalId: identity.outputs.principalId
    acrName: acr.outputs.name
    keyVaultName: keyVault.outputs.name
    serviceBusName: serviceBus.outputs.name
    eventHubsName: eventHubs.outputs.name
    lakeStorageName: storage.outputs.lakeName
    docIntelName: docIntel.outputs.name
  }
}

module containerApps 'modules/containerapps.bicep' = {
  name: 'containerapps'
  params: {
    location: location
    stem: stem
    tags: tags
    environment: environment
    logAnalyticsName: monitoring.outputs.logAnalyticsName
    uamiId: identity.outputs.id
    uamiClientId: identity.outputs.clientId
    acrLoginServer: acr.outputs.loginServer
    image: '${acr.outputs.loginServer}/${containerImageRepo}:${imageTag}'
    usePlaceholderImage: usePlaceholderImage
    keyVaultUri: keyVault.outputs.uri
    serviceBusFqdn: serviceBus.outputs.fqdn
    serviceBusKedaRuleId: serviceBus.outputs.kedaRuleId
    eventHubsFqdn: eventHubs.outputs.fqdn
    eventHubName: eventHubs.outputs.hubName
    lakeDfsUrl: storage.outputs.lakeDfsUrl
    docIntelEndpoint: docIntel.outputs.endpoint
    d365Url: d365Url
    d365TenantId: d365TenantId
    d365ClientId: d365ClientId
    d365Company: d365Company
    isaSenderId: isaSenderId
  }
  dependsOn: [ roles ] // Key Vault references + ACR pull need the role assignments first
}

module apim 'modules/apim.bicep' = {
  name: 'apim'
  params: {
    location: location
    name: 'apim-${stem}-${suffix}'
    tags: tags
    sku: apimSku
    publisherEmail: apimPublisherEmail
    uamiId: identity.outputs.id
    uamiClientId: identity.outputs.clientId
    keyVaultUri: keyVault.outputs.uri
    experienceFqdn: containerApps.outputs.experienceFqdn
    processFqdn: containerApps.outputs.processFqdn
    systemFqdn: containerApps.outputs.systemFqdn
    consoleOrigin: endsWith(storage.outputs.webEndpoint, '/') ? substring(storage.outputs.webEndpoint, 0, length(storage.outputs.webEndpoint) - 1) : storage.outputs.webEndpoint
    exposeSystemApi: exposeSystemApi
    appInsightsId: monitoring.outputs.appInsightsId
    appInsightsInstrumentationKey: monitoring.outputs.appInsightsInstrumentationKey
  }
  dependsOn: [ roles ]
}

output resourceGroup string = resourceGroup().name
output apimName string = apim.outputs.name
output apimGatewayUrl string = apim.outputs.gatewayUrl
output apimConsoleSubscription string = apim.outputs.consoleSubscriptionName
output acrName string = acr.outputs.name
output acrLoginServer string = acr.outputs.loginServer
output imageRepository string = containerImageRepo
output staticWebsiteStorageAccount string = storage.outputs.webName
output staticWebsiteUrl string = storage.outputs.webEndpoint
output lakehouseStorageAccount string = storage.outputs.lakeName
output containerAppNames array = [
  containerApps.outputs.experienceName
  containerApps.outputs.processName
  containerApps.outputs.systemName
]
output containerAppFqdns object = {
  experience: containerApps.outputs.experienceFqdn
  process: containerApps.outputs.processFqdn
  system: containerApps.outputs.systemFqdn
}
output keyVaultName string = keyVault.outputs.name
output serviceBusNamespace string = serviceBus.outputs.name
output eventHubsNamespace string = eventHubs.outputs.name
output postgresServer string = postgres.outputs.name
output appInsightsConnectionString string = monitoring.outputs.appInsightsConnectionString
