        "Premium"
      ],
      "metadata": {
        "description": "API Management SKU. Developer ≈ 30-45 min to provision; Consumption/BasicV2 are faster"
      }
    },
    "repositoryUrl": {
      "type": "string",
      "defaultValue": "https://github.com/amitagrawal09/tf-data-product-so",
