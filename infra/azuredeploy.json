      "type": "securestring",
      "defaultValue": ""
    },
    "d365Company": {
      "type": "string",
      "defaultValue": "usmf"
    },
    "forceUpdateTag": {
      "type": "string",
      "defaultValue": "[utcNow()]",
      "metadata": {
        "description": "Changes on every deployment so the deployment script re-runs (leave the default)"
      }
