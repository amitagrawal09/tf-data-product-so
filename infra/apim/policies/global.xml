<!--
  Global (all APIs) policy for the Sales Order data product gateway.
  Tokens replaced by Bicep at deploy time:
    __CORS_ORIGIN__  static-website origin of the Order Operations Console
    __RATE_LIMIT__   rate-limit-by-key element (omitted on the Consumption tier, which does not support it)
    AUTH_STRIP token removes caller-supplied backend keys (always) and dev persona headers (entra mode)
-->
<policies>
  <inbound>
    <cors allow-credentials="false">
      <allowed-origins>
        <origin>__CORS_ORIGIN__</origin>
        <origin>http://localhost:8080</origin>
      </allowed-origins>
      <allowed-methods preflight-result-max-age="600">
        <method>GET</method>
        <method>POST</method>
        <method>PUT</method>
        <method>PATCH</method>
        <method>DELETE</method>
        <method>OPTIONS</method>
      </allowed-methods>
      <allowed-headers>
        <header>*</header>
        <!-- includes Authorization (Entra bearer token) and x-dev-persona (non-prod personas) -->
      </allowed-headers>
      <expose-headers>
        <header>x-correlation-id</header>
        <header>ETag</header>
        <header>Location</header>
      </expose-headers>
    </cors>
    <!-- Callers never supply the backend key; product policies inject it for trusted service subscriptions -->
    __AUTH_STRIP__
    <!-- Correlation id: keep the caller's, otherwise use the APIM request id -->
    <set-header name="x-correlation-id" exists-action="skip">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    __RATE_LIMIT__
  </inbound>
  <backend>
    <forward-request timeout="60" />
  </backend>
  <outbound>
    <set-header name="x-correlation-id" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("x-correlation-id", context.RequestId.ToString()))</value>
    </set-header>
    <set-header name="X-Powered-By" exists-action="delete" />
    <set-header name="Server" exists-action="delete" />
  </outbound>
  <on-error>
    <set-header name="x-correlation-id" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("x-correlation-id", context.RequestId.ToString()))</value>
    </set-header>
  </on-error>
</policies>
