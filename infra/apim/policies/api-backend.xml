<!--
  API-level policy for each Tier-2 API (exp, process, system).
  The backend Container Apps run with TFSO_AUTH_MODE=apikey; APIM injects the key from Key Vault
  (named value "tfso-api-key"), so callers never hold the backend key and direct calls are rejected.
-->
<policies>
  <inbound>
    <base />
    <set-header name="x-api-key" exists-action="override">
      <value>{{tfso-api-key}}</value>
    </set-header>
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="x-forwarded-prefix" exists-action="override">
      <value>@(context.Api.Path)</value>
    </set-header>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
