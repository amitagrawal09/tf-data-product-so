<!--
  API-level policy for each Tier-2 API (exp, process, system).
  Identity is decided by the product policy (product-console.xml / product-sales-order.xml /
  product-order-status.xml): a user token or dev persona is forwarded as-is; only trusted service
  subscriptions get the backend key from Key Vault (named value "tfso-api-key"). Callers can never send
  their own x-api-key: the global policy strips it.
-->
<policies>
  <inbound>
    <base />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="x-forwarded-prefix" exists-action="override">
      <value>@(context.Api.Path)</value>
    </set-header>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
